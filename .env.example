# Copy to .env and fill in the values you need.
#
# NOTE: nothing loads .env automatically — export the variables in your shell
# before running any script (e.g. `set -a; source .env; set +a`).
# In CI these are provided as GitHub Actions secrets.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Required for `pnpm start` — GitHub API access (issues / PRs / releases /
# trending search). Also used as the API key for the github-copilot provider.
GITHUB_TOKEN=ghp_xxxxx

# Optional — target repo for publishing digests as GitHub Issues.
# Omit to only write Markdown files under digests/.
# DIGEST_REPO=owner/repo

# ---------------------------------------------------------------------------
# LLM provider (default: anthropic)
# Valid values: anthropic | openai | github-copilot | openrouter | deepseek | qwen
# ---------------------------------------------------------------------------

# LLM_PROVIDER=anthropic

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # read by the SDK; set for gateways
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# GitHub Copilot — uses GITHUB_TOKEN above, no separate key
# GITHUB_COPILOT_MODEL=gpt-4o

# OpenRouter
# OPENROUTER_API_KEY=sk-or-xxxxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen (Alibaba Model Studio) — provider used by the GitHub Actions daily run
# DASHSCOPE_API_KEY=sk-xxxxx

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------

# Optional — Product Hunt API token. Without it the ai-ph.md report is skipped.
# PRODUCTHUNT_TOKEN=xxxxx

# ---------------------------------------------------------------------------
# Pre-filter (Jev / TypeSafe System One) — optional
# ---------------------------------------------------------------------------
#
# When set, whole sources are gated and individual items scored against the
# `profile:` section of config.yml before any LLM call, so the digest reflects
# your interests and spends fewer tokens. Get a key at console.typesafe.ai/keys.
#
# When unset, a deterministic offline mock runs instead: the pipeline still
# works end to end, but the mock is deliberately lenient (keyword-based) so it
# never silently drops news.
#
# TYPESAFE_API_KEY=ts_xxxxx
# JEV_ENABLED=false            # kill switch: force pass-through even with a key
